# Proveedor de IA activo: 'gemini', 'deepseek', o 'openrouter'
AI_PROVIDER=gemini

# Clave de API de Google Gemini (Obtenla gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo de Gemini (Recomendado: gemini-3.5-flash-lite o gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Clave de API de DeepSeek Oficial (Obtenla en https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Clave de API de OpenRouter (DeepSeek R1 Gratis en https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Idioma de escucha (es-ES = Español, es-MX = Español México, en-US = Inglés)
AUDIO_LANGUAGE=es-ES

# Nivel de energía para detección de voz (0 = automático, o un número entre 300 y 4000)
ENERGY_THRESHOLD=0

# Siempre visible sobre otras ventanas (True o False)
ALWAYS_ON_TOP=True

# Opacidad de la ventana (0.7 a 1.0)
WINDOW_OPACITY=0.95

